# Graft — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Supabase ────────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

# Your project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — server-side only, bypasses Row Level Security
# Used exclusively by: /api/companion/sync and /api/analytics
# This key must NEVER be prefixed with NEXT_PUBLIC_ or sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Notes ───────────────────────────────────────────────────────────────────────
#
# The SUPABASE_SERVICE_ROLE_KEY is required because the Companion extension
# authenticates using a team API key (not a user JWT). Two server-side routes
# use the admin client to validate these keys and bypass RLS:
#
#   GET  /api/companion/sync  — returns active scripts for the Companion
#   POST /api/analytics       — ingests execution events from the Companion
#
# All other API routes use the user's JWT and are subject to full RLS enforcement.
#
# The key must be the JWT-format service_role key (starts with eyJ...).
# Supabase Dashboard → Settings → API → service_role
